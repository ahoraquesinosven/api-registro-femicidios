{
  "name": "api-registro-femicidios",
  "version": "1.0.0",
  "description": "API to track femicides by the Observatorio de las Violencias de Género \"Ahora Que Sí Nos Ven\".",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start:dev": "node --watch-path=./src src/index.js",
    "start:prod": "node src/index.js",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "npm run validate:openapi",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.js",
    "dump:openapi": "node src/scripts/dumpOpenapi.js /tmp/openapi.json",
    "validate:openapi": "npm run dump:openapi && redocly lint /tmp/openapi.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahoraquesinosven/api-registro-femicidios.git"
  },
  "author": "Observatorio de las Violencias de Género \"Ahora Que Sí Nos Ven\"",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ahoraquesinosven/api-registro-femicidios/issues"
  },
  "homepage": "https://github.com/ahoraquesinosven/api-registro-femicidios#readme",
  "dependencies": {
    "@koa/bodyparser": "^6.1.0",
    "@koa/cors": "^5.0.0",
    "@koa/router": "^15.6.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ajv-i18n": "^4.2.0",
    "axios": "^1.18.1",
    "jose": "^6.2.3",
    "knex": "^3.3.0",
    "koa": "^3.2.1",
    "pg": "^8.22.0",
    "rss-parser": "^3.13.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@redocly/cli": "^2.34.0"
  }
}
