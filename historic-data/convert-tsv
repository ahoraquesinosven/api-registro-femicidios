#!/usr/bin/env node

import fs from "fs";
import { parseTsv } from "./lib/tsv-transform.js";

const [inputFile, outputFile] = process.argv.slice(2);
if (!inputFile || !outputFile) {
    console.error("Usage: node convert-tsv.js <input.tsv> <output.json>");
    process.exit(1);
}

const data = fs.readFileSync(inputFile, "utf-8");
const rows = parseTsv(data);

fs.writeFileSync(outputFile, rows.map((row) => JSON.stringify(row)).join("\n"), { flag: "w" });
